{
  "name": "clubmed-qa-poc",
  "version": "1.0.0",
  "description": "POC QA Automation for Club Med App landing page using Playwright, Gherkin, CircleCI and Allure Report.",
  "main": "index.js",
  "scripts": {
    "test": "cross-env PW_HEADLESS=false PW_SLOW_MO=700 PW_HOLD_BROWSER_MS=5000 node scripts/run-tests-with-allure.cjs",
    "test:raw": "cucumber-js",
    "test:headed": "cross-env PW_HEADLESS=false PW_SLOW_MO=1200 PW_HOLD_BROWSER_MS=10000 node scripts/run-tests-with-allure.cjs",
    "test:observe": "cross-env PW_HEADLESS=false PW_SLOW_MO=700 node scripts/run-tests-with-allure.cjs",
    "test:observe:slow": "cross-env PW_HEADLESS=false PW_SLOW_MO=1500 PW_HOLD_BROWSER_MS=10000 node scripts/run-tests-with-allure.cjs",
    "test:debug": "cross-env PWDEBUG=1 PW_HEADLESS=false node scripts/run-tests-with-allure.cjs",
    "test:smoke": "node scripts/run-tests-with-allure.cjs --tags @smoke",
    "allure:generate": "allure generate reports/allure-results --clean -o reports/allure-report",
    "allure:open": "allure open reports/allure-report",
    "allure:serve": "allure serve reports/allure-results",
    "report": "npm run allure:generate",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },
  "keywords": [
    "qa",
    "automation",
    "playwright",
    "cucumber",
    "gherkin",
    "allure",
    "circleci"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.21",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "allure-commandline": "^2.34.0",
    "allure-cucumberjs": "^3.2.1",
    "cross-env": "^10.1.0",
    "dotenv": "^16.5.0",
    "eslint": "^9.27.0",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
